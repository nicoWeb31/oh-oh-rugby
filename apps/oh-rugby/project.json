{
  "name": "oh-rugby",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "oh-rugby",
  "sourceRoot": "apps/oh-rugby/src",
  "tags": ["scope:rugby"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/oh-rugby",
        "browser": "apps/oh-rugby/src/main.ts",
        "tsConfig": "apps/oh-rugby/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/oh-rugby/public"
          }
        ],
        "styles": ["apps/oh-rugby/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/oh-rugby/src/environments/environment.ts",
              "with": "apps/oh-rugby/src/environments/environment.prod.ts"
            }
          ]
        },
        "dev": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/oh-rugby/src/environments/environment.ts",
              "with": "apps/oh-rugby/src/environments/environment.dev.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "oh-rugby:build:production"
        },
        "development": {
          "buildTarget": "oh-rugby:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "oh-rugby:build",
        "port": 4200,
        "staticFilePath": "dist/apps/oh-rugby/browser",
        "spa": true
      }
    }
  }
}
